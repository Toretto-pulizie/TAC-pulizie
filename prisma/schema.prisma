// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

// Solo per i Collaboratori (role EMPLOYEE): un Amministrativo non ha una
// capacità fissa di 8h/giorno sul campo, quindi non conta per "Ore
// disponibili" in Consuntivi né compare come opzione per l'inserimento
// manuale di una timbratura.
enum TipoCollaboratore {
  OPERATIVO
  AMMINISTRATIVO
}

enum EntryType {
  TRAVEL_START
  WORK_START
  WORK_END
  SOPRALLUOGO_START
  SOPRALLUOGO_END
}

enum ServiceType {
  ONE_SHOT
  PASS_SETTIMANALE
  PASS_MENSILE
}

enum QuoteStatus {
  IN_TRATTATIVA
  ACCETTATO
  RIFIUTATO
}

enum ClientTipo {
  AZIENDA
  PERSONA_FISICA
  ENTE
  ASSOCIAZIONE
}

enum TipoAssenza {
  INFORTUNIO
  MALATTIA
  PERMESSO
  PERMESSO_RETRIBUITO
  LEGGE_104
  FERIE_RICHIESTE
  FERIE_AZIENDALI
  MATERNITA_ANTICIPATA
  MATERNITA_FACOLTATIVA
}

enum StatoRichiesta {
  IN_ATTESA
  APPROVATO
  RIFIUTATO
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  cognome      String?
  telefono     String?
  role         Role        @default(EMPLOYEE)
  tipoCollaboratore TipoCollaboratore @default(OPERATIVO)
  allowedModules String[]  @default([])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  timeEntries  TimeEntry[]
  shifts       Shift[]
  shiftPlans   ShiftPlan[]
  leaveRequests LeaveRequest[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model LeaveRequest {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tipo       TipoAssenza
  dataInizio DateTime
  dataFine   DateTime
  note       String?
  stato      StatoRichiesta @default(IN_ATTESA)
  createdAt  DateTime       @default(now())
  decisoAt   DateTime?

  @@index([userId, dataInizio])
}

model Client {
  id                 String     @id @default(cuid())
  tipo               ClientTipo @default(AZIENDA)
  name               String
  ragioneSociale     String?
  nome               String?
  cognome            String?
  indirizzo          String?
  citta              String?
  cap                String?
  provincia          String?
  // Nullo per i clienti "interni" (es. uso personale del titolare) creati
  // senza codice, che non seguono la numerazione progressiva dei clienti
  // veri.
  codiceCliente      Int?       @unique @default(autoincrement())
  partitaIva         String?
  codiceFiscale      String?
  // Codice Destinatario SDI per la fatturazione elettronica.
  codiceUnivoco      String?
  // Condizioni di pagamento predefinite di questo cliente (es. "30 gg data
  // fattura"): proposta come punto di partenza nei preventivi, restano comunque
  // modificabili preventivo per preventivo.
  condizioniPagamento String?
  personaRiferimento String?
  // Contatto della persona di riferimento, distinto da telefono/email del
  // cliente (es. centralino aziendale vs. recapito diretto della persona).
  telefonoRiferimento String?
  emailRiferimento   String?
  telefono           String?
  email              String?
  notes              String?
  createdAt          DateTime   @default(now())
  sites              Site[]
  quotes             Quote[]
}

// Voci preimpostate per il campo "Condizioni di pagamento", gestibili da
// Impostazioni e selezionabili sia in anagrafica Cliente sia nel preventivo.
model CondizionePagamento {
  id        String   @id @default(cuid())
  etichetta String
  ordine    Int      @default(0)
  createdAt DateTime @default(now())
}

model Site {
  id          String      @id @default(cuid())
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  name        String
  address     String
  lat         Float?
  lng         Float?
  notes       String?
  capienza    Int?
  createdAt   DateTime    @default(now())
  timeEntries TimeEntry[]
  shifts      Shift[]
  shiftPlans  ShiftPlan[]
  quoteSites  QuoteSite[]
}

model Quote {
  id                  String      @id @default(cuid())
  numeroOfferta       Int         @default(autoincrement())
  client              Client      @relation(fields: [clientId], references: [id])
  clientId            String
  sites               QuoteSite[]
  attachments         QuoteAttachment[]
  condizioniPagamento String?
  status              QuoteStatus @default(IN_TRATTATIVA)
  createdAt           DateTime    @default(now())
  closedAt            DateTime?

  @@index([clientId, status])
}

model QuoteSite {
  id                String      @id @default(cuid())
  quote             Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId           String
  site              Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId            String
  tipoPrestazione   String      @default("")
  serviceType       ServiceType
  ore               Float
  spostamento       Float       @default(0)
  oneShotCount      Float       @default(1)
  passSettimanale   Float?
  passMensile       Float?
  oreVetri          Float       @default(0)
  passVetriAnno     Float       @default(0)
  tariffaOraria     Float       @default(25)
  tariffaVetri      Float       @default(30)
  tariffaConsuntivo Float       @default(25)
  scontoPct         Float?
  prezzoVenduto     Float?
  adeguamento       Float?
  note              String?
  shiftPlans        ShiftPlan[]

  @@index([siteId])
  @@index([quoteId])
}

model Fornitore {
  id              String   @id @default(cuid())
  name            String
  partitaIva      String?
  codiceFiscale   String?
  indirizzo       String?
  citta           String?
  telefono        String?
  email           String?
  note            String?
  codiceFornitore Int      @unique @default(autoincrement())
  createdAt       DateTime @default(now())
}

model Collaboratore {
  id                  String   @id @default(cuid())
  nome                String
  cognome             String?
  codiceFiscale       String?
  indirizzo           String?
  citta               String?
  telefono            String?
  email               String?
  note                String?
  codiceCollaboratore Int      @unique @default(autoincrement())
  createdAt           DateTime @default(now())
}

model TipoPrestazione {
  id            String   @id @default(cuid())
  etichetta     String
  abbreviazione String?
  ordine        Int      @default(0)
  createdAt     DateTime @default(now())
}

model QuotePhrase {
  id        String   @id @default(cuid())
  codice    Int      @unique @default(autoincrement())
  titolo    String
  testo     String
  ordine    Int      @default(0)
  createdAt DateTime @default(now())
}

model ServiceTypeLabel {
  tipo          ServiceType @id
  etichetta     String
  abbreviazione String?
  mostraCadenza Boolean     @default(true)
}

// Riga singola: decide quali sezioni compaiono nella home del programma.
model HomeSettings {
  id                       String  @id @default("singleton")
  showAlLavoro             Boolean @default(true)
  showPermessi             Boolean @default(true)
  showPreventivi           Boolean @default(true)
  showTurni                Boolean @default(true)
  showTotalePreventiviAccettati Boolean @default(true)
  showTotaleConsuntivi     Boolean @default(true)
  showAlLavoroBar          Boolean @default(true)
  showPreventiviBar        Boolean @default(true)
  showTotaleConsuntiviBar  Boolean @default(true)
}

model BankSettings {
  id           String  @id @default("singleton")
  nomeBanca    String  @default("")
  iban         String  @default("")
  intestatario String  @default("")
  swiftBic     String  @default("")
}

model Attachment {
  id        String            @id @default(cuid())
  nome      String
  fileName  String
  mimeType  String
  data      Bytes
  createdAt DateTime          @default(now())
  quotes    QuoteAttachment[]
}

model QuoteAttachment {
  id           String     @id @default(cuid())
  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId      String
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  attachmentId String
  ordine       Int        @default(0)

  @@unique([quoteId, attachmentId])
  @@index([quoteId])
  @@index([attachmentId])
}

model Shift {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  plan      ShiftPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId    String?
  start     DateTime
  end       DateTime
  notes     String?
  createdAt DateTime   @default(now())

  @@unique([planId, start])
  @@index([userId, start])
  @@index([siteId, start])
}

// Regola di ricorrenza per generare automaticamente i turni di un servizio
// continuativo (Passaggio settimanale/mensile). Un job pianificato (vedi
// src/app/api/cron/genera-turni) materializza i singoli Shift a partire da
// questa regola; modificare/eliminare un singolo Shift generato non tocca
// il piano, che continua a generarne altri in futuro.
model ShiftPlan {
  id            String     @id @default(cuid())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  site          Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId        String
  quoteSite     QuoteSite? @relation(fields: [quoteSiteId], references: [id], onDelete: SetNull)
  quoteSiteId   String?
  daysOfWeek    Int[]
  intervalWeeks Int        @default(1)
  startTime     String
  endTime       String
  dataInizio    DateTime
  dataFine      DateTime?
  note          String?
  createdAt     DateTime   @default(now())
  shifts        Shift[]

  @@index([siteId])
  @@index([userId])
  @@index([quoteSiteId])
}

model TimeEntry {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  site      Site?     @relation(fields: [siteId], references: [id])
  siteId    String?
  type      EntryType
  timestamp DateTime  @default(now())
  // Vero quando questo orario è solo un segnaposto (inserimento manuale con
  // sole "Ore lavorate", senza Inizio/Fine noti): in griglia va mostrato
  // vuoto finché non viene impostato esplicitamente un orario reale.
  orarioStimato Boolean @default(false)
  lat       Float?
  lng       Float?
  note      String?
  // Descrizione libera del luogo, usata per i Sopralluoghi fatti presso
  // potenziali clienti non ancora in anagrafica (senza un Cliente/Sede
  // collegato).
  luogo     String?
  // Lega tra loro le voci (Spostamento/Inizio/Fine) create per la stessa
  // sessione, così l'abbinamento non deve più essere indovinato dall'ordine
  // cronologico: indispensabile quando due sessioni diverse hanno lo stesso
  // orario (es. inserimenti manuali con lo stesso orario segnaposto). Nullo
  // sui dati storici precedenti a questo campo, che restano abbinati con la
  // vecchia logica basata sull'orario.
  sessionId String?

  @@index([sessionId])
}
