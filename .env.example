# Connessione al database Postgres (es. Neon).
# Aggiungere &pgbouncer=true se ci si connette tramite un connection pooler
# (necessario per evitare errori "cached plan must not change result type"
# dopo una migrazione dello schema).
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"

# Connessione diretta (senza connection pooler), usata solo da "prisma migrate
# deploy" durante il build. Con Neon è lo stesso host di sopra ma senza
# "-pooler" nel nome. Necessaria per evitare che il lock delle migrazioni
# resti bloccato su una connessione pooled riusata da query dell'app.
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Chiave segreta per firmare le sessioni di accesso. Generane una nuova con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Usate solo in produzione al primo deploy per creare l'account amministratore.
# Dopo il primo accesso puoi cambiare la password dalla pagina di modifica dipendente.
INITIAL_ADMIN_EMAIL="admin@toret-to.it"
INITIAL_ADMIN_PASSWORD=""

# Invio delle offerte via email (Impostazioni -> Email). Se mancano, il pulsante
# "Invia" avvisa che la posta non e' configurata. Su Vercel vanno impostate in
# Settings -> Environment Variables (solo Production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=info@example.com
# SMTP_PASS=
# SMTP_FROM="Azienda <info@example.com>"
